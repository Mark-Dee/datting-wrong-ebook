{
  "name": "dating-wrong",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "generate:public-book": "tsx scripts/generatePublicBook.ts",
    "dev": "npm run generate:public-book && tsx --env-file-if-exists=.env server.ts",
    "build:web": "vite build",
    "build:api": "esbuild server/vercelEntry.ts --bundle --platform=node --format=esm --packages=external --outfile=api/index.js",
    "build:server": "esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "build": "npm run generate:public-book && npm run build:web && npm run build:api && npm run build:server",
    "start": "node --env-file-if-exists=.env dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist api/index.js",
    "lint": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "nodemailer": "^10.2.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^8.0.2",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
